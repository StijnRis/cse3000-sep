{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node", "fs-extra"],
        "rootDir": "./src",
        "outDir": "./build",
        "strict": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "isolatedModules": true,
        "strictPropertyInitialization": false
    }
}